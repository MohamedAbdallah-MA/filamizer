{
    "name": "filament-customizer/filament-customizer",
    "description": "Runtime dashboard customizer for Filament panels: theme presets, colors, Arabic/Latin fonts, density, radius and dark mode.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["filament", "filament-plugin", "theme", "customizer", "rtl", "arabic"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-settings": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "FilamentCustomizer\\": "src/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "laravel/pint": "^1.24"
    },
    "autoload-dev": {
        "psr-4": {
            "FilamentCustomizer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "format": "@php vendor/bin/pint"
    },
    "archive": {
        "exclude": ["/vendor", "/tests", "/.github", "/.phpunit.cache", "/docs/ARCHITECTURE.md", "/docs/UX-EXPERIMENT.md", "/composer.lock"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "FilamentCustomizer\\FilamentCustomizerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

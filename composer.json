{
    "name": "deal-art/filament-studio",
    "description": "Runtime dashboard customizer for Filament panels: theme presets, colors, Arabic/Latin fonts, density, radius and dark mode.",
    "type": "library",
    "version": "0.1.0",
    "license": "proprietary",
    "keywords": ["filament", "filament-plugin", "theme", "customizer", "rtl", "arabic"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-settings": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "DealArt\\FilamentStudio\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DealArt\\FilamentStudio\\FilamentStudioServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
